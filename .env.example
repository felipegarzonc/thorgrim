# Claude API key (https://platform.claude.com) — required for the coach.
ANTHROPIC_API_KEY=

# Optional: model for the coach (default claude-opus-5-5).
# COACH_MODEL=claude-opus-5-5

# Optional: require this key (header x-access-key) when the app is hosted online.
# APP_ACCESS_KEY=

# Optional: where uploads, lists and games are stored (default ./storage).
# STORAGE_DIR=storage
# PORT=8787
